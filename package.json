{
  "name": "@alilc/lowcode-engine-ext",
  "version": "1.0.6",
  "description": "阿里低代码引擎官方 setter（设置器）与必需插件集合",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css",
    "./fusion.css": "./dist/fusion.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "lowcode",
    "react",
    "setter",
    "component"
  ],
  "dependencies": {
    "@alilc/lowcode-engine": "workspace:*",
    "@alilc/lowcode-plugin-base-monaco-editor": "workspace:*",
    "@alilc/lowcode-types": "workspace:*",
    "@alilc/lowcode-utils": "workspace:*",
    "acorn": "^8.19.0",
    "antd": "^6.6.6",
    "classnames": "^2.5.1",
    "cssjson": "^2.1.3",
    "intl-messageformat": "^12.1.3",
    "js-beautify": "^2.0.3",
    "moment": "^2.31.0",
    "react-color": "^2.19.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@alifd/next": "^1.27.34",
    "@alifd/theme-lowcode-light": "^0.2.1",
    "@alilc/lowcode-editor-skeleton": "workspace:*",
    "@types/js-beautify": "^1.14.3",
    "@types/react": "^19.3.0",
    "@types/react-color": "^3.0.13",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "less": "^4.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.105.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  },
  "peerDependencies": {
    "@alifd/next": "^1.27.34",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "homepage": "https://github.com/alibaba/lowcode-engine-ext#readme",
  "repository": "git@github.com:alibaba/lowcode-engine-ext.git"
}
